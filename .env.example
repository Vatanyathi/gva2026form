# Optional shared secret so the /api/kv endpoint isn't wide open to random
# internet traffic. Not real per-user auth — see the note in api/kv.js.
# Set the SAME value in two places in Vercel:
#   1. API_SECRET       (server-side, Project Settings -> Environment Variables)
#   2. VITE_API_SECRET  (client-side, same value, same place)
API_SECRET=
VITE_API_SECRET=
